<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # HTTP ni HTTPS ga yo'naltirish (ixtiyoriy, agar kerak bo'lsa izohdan oling)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # public papkasidagi fayllarga to'g'ridan-to'g'ri kirish
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
