# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sertifikat_db
DB_USER=postgres
DB_PASS=your_password

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=86400

# App
APP_URL=http://localhost:8000
APP_ENV=development
APP_DEBUG=true
OFFLINE_MODE=true
CORS_ORIGINS=http://localhost:8000

# File Storage
UPLOAD_PATH=public/uploads
MAX_FILE_SIZE=10485760

# Email (local SMTP, OFFLINE_MODE=true holatida yuborilmaydi)
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@sertifikat.uz
MAIL_FROM_NAME=Sertifikat Tizimi

# SMS o'chirilgan
SMS_EMAIL=
SMS_PASSWORD=

# Payment - Click
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# Payment - Payme
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# Payment - Uzum
UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
